    "proper-lockfile": "^4.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "write-file-atomic": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
